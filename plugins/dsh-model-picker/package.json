{
  "name": "dsh-model-picker",
  "version": "0.1.0",
  "description": "Search and favourites for the DSH composer model selector, with a shared favourites list the Model Manager settings page edits too.",
  "type": "module",
  "private": false,
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "model-picker",
    "model-selector",
    "favourites",
    "favorites"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test --test-isolation=none test/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vit-cerny/dsh-cli.git",
    "directory": "plugins/dsh-model-picker"
  },
  "homepage": "https://github.com/vit-cerny/dsh-cli/tree/main/plugins/dsh-model-picker#readme",
  "bugs": {
    "url": "https://github.com/vit-cerny/dsh-cli/issues"
  }
}
