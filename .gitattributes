# Normalize line endings across the repo.
#
# The host git install has core.autocrlf=true, which would rewrite every
# .js/.json file to CRLF on checkout and produce endless whitespace-only
# diffs. Pin the project to LF and let Windows tooling cope.

* text=auto eol=lf

# Source, config and docs are always LF.
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Shell entry points must stay LF even on Windows checkouts.
*.sh    text eol=lf

# Windows-only files keep CRLF.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets are never converted or diffed as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.zip   binary

# .gitkeep placeholders are empty markers; keep them stable.
*.gitkeep text eol=lf
