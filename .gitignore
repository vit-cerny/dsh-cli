# ---- dependencies ----
node_modules/
.pnpm-store/
.pnpm-debug.log*

# ---- build output (project is no-build; these are safety nets) ----
dist/
build/
out/
*.tsbuildinfo

# ---- runtime state & logs ----
*.log
logs/
npm-debug.log*
yarn-error.log*
.pids
*.pid
*.seed

# ---- secrets & local env ----
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
/auth.json
.dsh/local/
.tmp-*.json

# ---- local scratch / big dumps ----
# work/ holds local tooling dumps and opencode-config.json, which contains
# live third-party API credentials. Never commit it.
work/
tmp/
temp/
*.tmp

# Launcher directory created by scripts/install.mjs
.dsh-cli/

# ---- coverage & test artifacts ----
coverage/
.nyc_output/
*.lcov
junit.xml

# ---- editor / OS cruft ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# ---- orchestration tool state (not project source) ----
.agent-teams/
.expert-taskboards/
.expert-bus/
.t3/

# ---- local toolchains ----
# .tools/ is a per-machine Rust toolchain (rustup + cargo, ~770 MB of binaries).
# It is never project source: the Rust client builds from rust/Cargo.toml with
# whatever toolchain the user already has.
.tools/
rust/target/

# ---- local tool fork / config backups (may hold credentials) ----
_orig/
*.zip
dsh-audit.ps1
token-audit.ps1

# ---- local measurement scratch ----
dsh-live-measure.mjs
