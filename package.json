{
  "name": "dsh-cli",
  "version": "0.0.1",
  "description": "DeepSeek Harness terminal client: zero-build, zero-runtime-dependency ESM CLI",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "dsh-cli": "./src/main.js"
  },
  "main": "./src/main.js",
  "exports": {
    ".": "./src/main.js"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "start": "node src/main.js",
    "install:cli": "node scripts/install.mjs",
    "install:profile": "node scripts/install-profile.mjs",
    "uninstall": "node scripts/uninstall.mjs",
    "test": "node --test --test-isolation=none \"tests/**/*.test.js\"",
    "lint": "node --check src/main.js",
    "doctor": "node src/main.js doctor",
    "ram:check": "node tests/ram/benchmark.mjs",
    "ram:runtime": "node tests/ram/runtime-benchmark.mjs",
    "ram:session": "pwsh -NoProfile -File tests/ram/session-rss.ps1"
  },
  "keywords": [
    "deepseek",
    "harness",
    "cli",
    "tui",
    "esm"
  ]
}
